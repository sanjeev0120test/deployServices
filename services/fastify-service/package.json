{
  "name": "fastify-service",
  "version": "1.0.0",
  "description": "Fastify microservice with OpenTelemetry and Prometheus",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/"
  },
  "dependencies": {
